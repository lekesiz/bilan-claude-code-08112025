{
  "version": 2,
  "builds": [
    {
      "src": "frontend",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/$1",
      "methods": ["GET", "HEAD"]
    }
  ],
  "env": {
    "VITE_API_URL": "@vite_api_url"
  }
}
